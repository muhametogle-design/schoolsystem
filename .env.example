# --- Database ---
# Production (recommended): PostgreSQL 16
# DATABASE_URL=postgresql+psycopg2://school:school@db:5432/schoolsystem
# Demo tier (zero-infra default): SQLite
DATABASE_URL=sqlite:///./data/schoolsystem.db

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-64-byte-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- App ---
APP_ENV=development
CORS_ORIGINS_RAW=*

# --- Session cookie (fallback when a proxy strips the Authorization header) ---
# Embedded/cross-site contexts (iframe previews, partner dashboards) reject
# SameSite=lax cookies. Set "none" there — it forces Secure automatically.
COOKIE_SAMESITE=lax           # lax | strict | none
COOKIE_SECURE=auto            # auto | true | false

# --- Compliance engine ---
ATTENDANCE_DEADLINE=12:00     # mandatory daily roster deadline
ALARM_AUDIT_TIME=15:00        # 3-hour RED ALARM audit worker cron
PLATFORM_TIMEZONE=Africa/Nairobi

# --- Behaviour ---
AUTO_SEED_DEMO=true           # seed demo schools when the DB comes up empty
ENABLE_SCHEDULER=true         # arm the in-process 15:00 worker cron

# --- Module 4: encrypted midnight backups ---
BACKUP_TIME=00:00             # daily export window (platform timezone)
BACKUP_DIR=data/backups       # encrypted artefact storage
BACKUP_RETENTION_DAYS=30
ENABLE_BACKUP_SCHEDULER=true
# Dedicated passphrase for backup AES-256-GCM encryption. REQUIRED for
# production; when empty, a key is derived from JWT_SECRET_KEY (demo only).
BACKUP_ENCRYPTION_KEY=

# --- Module 5: WebAuthn / biometric hardware ---
# "auto" resolves the RP ID/origin from the request host (localhost, previews).
# Pin them in production, e.g.:
# WEBAUTHN_RP_ID=school.example
# WEBAUTHN_EXPECTED_ORIGINS=https://school.example
WEBAUTHN_RP_ID=auto
WEBAUTHN_EXPECTED_ORIGINS=auto
