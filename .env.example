# --- Database ---
DATABASE_URL=postgresql+psycopg2://neemis:neemis@localhost:5432/neemis

# --- Auth ---
# HS256 for local dev; RS256 in production with PEM key paths.
JWT_SECRET_KEY=change-me-to-a-64-byte-random-secret
JWT_ALGORITHM=HS256
# JWT_ALGORITHM=RS256
# JWT_PUBLIC_KEY_PATH=./certs/jwt-public.pem
# JWT_PRIVATE_KEY_PATH=./certs/jwt-private.pem
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- App ---
APP_ENV=development
API_PORT=5000
APP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,*
LOG_LEVEL=INFO

# --- Demo / container endpoints ---
# true: /students list/add is unauthenticated and backed by SQLite below.
# false: /students requires JWT + campus and uses PostgreSQL (production).
NEEMIS_DEMO_MODE=true
NEEMIS_DEMO_DB_PATH=./data/demo_store.db

# --- Crypto / record locking scheme ---
LOCK_ALGORITHM=Ed25519
LOCK_KEY_VERSION=1
# Comma separated roles that may request state-level unlock signature
STATE_UNLOCK_ROLES=state_admin,system

# --- Overnight aggregation ---
AGGREGATION_WINDOW_TZ=Africa/Lagos
AGGREGATION_BATCH_LIMIT=10000
